<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.sistemas_clientes.controller.DetalleClienteController"
            prefWidth="750"
            prefHeight="520">

    <top>
        <VBox alignment="CENTER" spacing="5">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            <children>
                <Label text="Detalle del Cliente"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Información del cliente seleccionado"/>
            </children>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="40">
            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>
            <children>
                <VBox alignment="TOP_CENTER" spacing="10">
                    <children>
                        <Label text="Fotografía" style="-fx-font-weight: bold;"/>
                        <ImageView fx:id="imageFoto"
                                   fitWidth="200"
                                   fitHeight="220"
                                   preserveRatio="true"/>
                    </children>
                </VBox>

                <GridPane hgap="15" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="170"/>
                        <ColumnConstraints minWidth="200" prefWidth="250"/>
                    </columnConstraints>

                    <Label text="Nombres:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="lblNombres" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Apellidos:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="lblApellidos" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Tipo de cliente:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="lblTipoCliente" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Ciudad:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="lblCiudad" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Fecha de nacimiento:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="lblFechaNacimiento" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Tipo de solicitud:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <Label fx:id="lblTipoSolicitud" text="-"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Servicios:" style="-fx-font-weight: bold;"
                           GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <Label fx:id="lblServicios" text="-" wrapText="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>
            </children>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="20" left="10"/>
            </padding>
            <children>
                <Button text="Regresar a Consulta"
                        prefWidth="180"
                        onAction="#regresar"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>
